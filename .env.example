# ─── CONFIGURACIÓN DE IA ──────────────────────────────────────────────────────
# GEMINI_API_KEY: Requerido para llamadas al servidor de IA.
# Obtenlo en: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="TU_API_KEY_AQUI"

# Puerto del servidor backend
PORT=3001

# URL de la API (Frontend necesita esto para conectar con el motor de IA)
VITE_API_URL="http://localhost:3001"

# ─── CONFIGURACIÓN CLOUD (SUPABASE) ──────────────────────────────────────────
# Configura estas variables para activar el Modo Cloud y persistencia real.
VITE_SUPABASE_URL="https://tu-proyecto.supabase.co"
VITE_SUPABASE_ANON_KEY="tu-anon-key-aqui"

# ─── CONFIGURACIÓN DE APP ────────────────────────────────────────────────────
# URL base de la aplicación (usada para despliegue)
APP_URL="http://localhost:3000"
